<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/shell_background</item>
    </style>

    <!-- Theme the bridge switches to once it starts. The window background is
         what shows behind the system bars while the page has not drawn yet,
         and behind them for good on WebView older than 140, where Capacitor
         pads the WebView instead of letting the page go edge to edge. The bar
         colours only matter below API 35: from there on, edge to edge is
         enforced and the bars are transparent. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/shell_background</item>
        <item name="android:statusBarColor">@color/shell_background</item>
        <item name="android:navigationBarColor">@color/shell_background</item>
    </style>

    <!-- Launch theme: system splash screen on the site's background colour
         with the app icon, the way the TWA starts. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/shell_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
