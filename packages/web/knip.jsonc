{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Dead code, found by following imports rather than by grepping.
  //
  // An unused export is invisible to TypeScript, to ESLint and to the bundler
  // alike: it type checks, it lints, and it is tree-shaken out of the bundle,
  // so it costs nothing at runtime and everything at reading time. The audit
  // of September 2026 (annexe B, Mo5) found three orphan files and some twenty
  // exports nothing imported any more; nothing in the tooling had seen them.
  //
  // `entry` lists only what knip cannot infer. `src/main.tsx`, `index.html`,
  // the Vite, Vitest and ESLint configs, the test files (`src/**/*.test.*`,
  // `tests/`) and the Vitest setup file are found by knip's own plugins, and
  // `scripts/lint-budget.mjs` through `package.json`. `src/sw.ts` needs no
  // entry either: it is the registration module, imported by `main.tsx`; the
  // worker itself is generated by Workbox (`generateSW`). What is left:
  //
  // - the two generators under `scripts/`, run by hand when the icons or the
  //   polar diagrams change, never imported and absent from `package.json`.
  //
  // `project` includes the stylesheets so the `@import` graph of `index.css`
  // is followed too: that is what proves `tailwindcss` is really used, and it
  // is what catches a `.css` file left behind by a page that no longer
  // imports it.
  "entry": ["scripts/gen-icons.mjs"],
  "project": ["src/**/*.{ts,tsx,css}", "scripts/*.mjs", "tests/**/*.ts"],

  "ignoreIssues": {
    // Named export for the tests, default export for `React.lazy` in
    // `MethodologiePage.tsx`, which only accepts a module whose default is a
    // component. Both are used, the duplicate is the point.
    "src/routes/TidalSourcesMap.tsx": ["duplicates"]
  }
}
